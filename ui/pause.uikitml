<!-- ui/pause.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 2; background-color: rgba(0,0,0,0.9); border-color: #ffcc00; border-width: 0.1; border-radius: 1; align-items: center; gap: 1; }
  .title { font-size: 3; color: #ffcc00; font-weight: bold; }
  .btn { font-size: 2; color: #00ffff; background-color: rgba(0,255,255,0.1); padding-top: 0.5; padding-bottom: 0.5; padding-left: 3; padding-right: 3; border-color: #00ffff; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
  .btn-quit { color: #ff4444; border-color: #ff4444; background-color: rgba(255,68,68,0.1); }
</style>
<div class="panel">
  <span class="title">PAUSED</span>
  <div id="btn-resume" class="btn">RESUME</div>
  <div id="btn-quit" class="btn btn-quit">QUIT</div>
</div>
