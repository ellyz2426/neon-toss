<!-- ui/tournament.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 2; background-color: rgba(0,0,0,0.85); border-color: #ff8800; border-width: 0.1; border-radius: 1; align-items: center; gap: 0.5; }
  .title { font-size: 3; color: #ff8800; font-weight: bold; }
  .info { font-size: 1.5; color: #ffcc00; }
  .round { font-size: 2; color: #ffffff; font-weight: bold; }
  .scores { display: flex; flex-direction: row; gap: 2; }
  .score-block { display: flex; flex-direction: column; align-items: center; gap: 0.2; }
  .label { font-size: 1; color: #888888; }
  .score { font-size: 2.5; color: #00ffff; font-weight: bold; }
  .opponent { font-size: 1.3; color: #ff3344; }
  .status { font-size: 1.5; color: #33ff33; }
</style>
<div class="panel">
  <span class="title">TOURNAMENT</span>
  <span id="tourn-round" class="round">Round 1 of 4</span>
  <span id="tourn-stage" class="info">Quarter-Final</span>
  <div class="scores">
    <div class="score-block">
      <span class="label">YOU</span>
      <span id="tourn-p-score" class="score">0</span>
    </div>
    <div class="score-block">
      <span class="label">VS</span>
      <span id="tourn-opp" class="opponent">ROOKIE</span>
    </div>
    <div class="score-block">
      <span class="label">CPU</span>
      <span id="tourn-ai-score" class="score">0</span>
    </div>
  </div>
  <span id="tourn-turn" class="status">YOUR TURN</span>
  <span id="tourn-rings" class="info">Rings: 5</span>
  <span id="tourn-record" class="label">W0 - L0</span>
</div>
