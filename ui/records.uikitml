<!-- ui/records.uikitml — Per-mode best scores -->
<style>
  .panel { display: flex; flex-direction: column; padding: 2; background-color: rgba(0,0,0,0.85); border-color: #ffcc00; border-width: 0.1; border-radius: 1; align-items: center; gap: 0.3; }
  .title { font-size: 2.5; color: #ffcc00; font-weight: bold; }
  .row { display: flex; flex-direction: row; gap: 1.5; }
  .mode { font-size: 1.2; color: #888888; }
  .best { font-size: 1.2; color: #00ffff; font-weight: bold; }
  .page { font-size: 1; color: #666666; }
  .btn { font-size: 1.3; color: #888888; background-color: rgba(128,128,128,0.1); padding-top: 0.3; padding-bottom: 0.3; padding-left: 1.5; padding-right: 1.5; border-color: #555555; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
  .nav { display: flex; flex-direction: row; gap: 1; }
</style>
<div class="panel">
  <span class="title">MODE RECORDS</span>
  <div class="row"><span class="mode">CLASSIC</span><span id="rec-classic" class="best">--</span></div>
  <div class="row"><span class="mode">SPEED</span><span id="rec-speed" class="best">--</span></div>
  <div class="row"><span class="mode">TARGET</span><span id="rec-target" class="best">--</span></div>
  <div class="row"><span class="mode">DISTANCE</span><span id="rec-distance" class="best">--</span></div>
  <div class="row"><span class="mode">TRICK</span><span id="rec-trick" class="best">--</span></div>
  <div class="row"><span class="mode">DAILY</span><span id="rec-daily" class="best">--</span></div>
  <div class="row"><span class="mode">SURVIVAL</span><span id="rec-survival" class="best">--</span></div>
  <div class="row"><span class="mode">MARATHON</span><span id="rec-marathon" class="best">--</span></div>
  <div class="row"><span class="mode">PRECISION</span><span id="rec-precision" class="best">--</span></div>
  <div class="row"><span class="mode">CARNIVAL</span><span id="rec-carnival" class="best">--</span></div>
  <div class="row"><span class="mode">RICOCHET</span><span id="rec-ricochet" class="best">--</span></div>
  <div class="row"><span class="mode">ELIMINATION</span><span id="rec-elimination" class="best">--</span></div>
  <div class="row"><span class="mode">DUEL</span><span id="rec-duel" class="best">--</span></div>
  <div class="row"><span class="mode">ARCADE</span><span id="rec-arcade" class="best">--</span></div>
  <div class="row"><span class="mode">TOURNAMENT</span><span id="rec-tournament" class="best">--</span></div>
  <div id="btn-rec-back" class="btn">BACK</div>
</div>
