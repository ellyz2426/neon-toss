<!-- ui/skins.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 1.5; background-color: rgba(0,0,0,0.85); border-color: #00ffff; border-width: 0.1; border-radius: 1; gap: 0.35; align-items: center; }
  .title { font-size: 2.5; color: #00ffff; font-weight: bold; }
  .row { display: flex; flex-direction: row; gap: 0.35; }
  .skin-btn { display: flex; flex-direction: column; padding-top: 0.15; padding-bottom: 0.15; padding-left: 0.5; padding-right: 0.5; background-color: rgba(0,255,255,0.05); border-color: #333333; border-width: 0.03; border-radius: 0.3; cursor: pointer; align-items: center; gap: 0.1; }
  .skin-name { font-size: 0.8; color: #00ffff; }
  .skin-status { font-size: 0.6; color: #888888; }
  .back { font-size: 1.4; color: #888888; background-color: rgba(128,128,128,0.1); padding-top: 0.3; padding-bottom: 0.3; padding-left: 1.5; padding-right: 1.5; border-color: #555555; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
</style>
