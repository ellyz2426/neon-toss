<!-- ui/settings.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 2; background-color: rgba(0,0,0,0.85); border-color: #00ffff; border-width: 0.1; border-radius: 1; gap: 0.6; align-items: center; }
  .title { font-size: 2.5; color: #00ffff; font-weight: bold; }
  .row { display: flex; flex-direction: row; gap: 0.5; align-items: center; }
  .label { font-size: 1.3; color: #888888; }
  .value { font-size: 1.3; color: #00ffff; font-weight: bold; }
  .btn { font-size: 1.5; color: #00ffff; background-color: rgba(0,255,255,0.1); padding-top: 0.2; padding-bottom: 0.2; padding-left: 0.8; padding-right: 0.8; border-color: #00ffff; border-width: 0.03; border-radius: 0.3; cursor: pointer; }
  .back { font-size: 1.4; color: #888888; background-color: rgba(128,128,128,0.1); padding-top: 0.3; padding-bottom: 0.3; padding-left: 1.5; padding-right: 1.5; border-color: #555555; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
</style>
<div class="panel">
  <span class="title">SETTINGS</span>
  <div class="row">
    <span class="label">MASTER</span>
    <div id="btn-master-down" class="btn">-</div>
    <span id="set-master" class="value">80%</span>
    <div id="btn-master-up" class="btn">+</div>
  </div>
  <div class="row">
    <span class="label">SFX</span>
    <div id="btn-sfx-down" class="btn">-</div>
    <span id="set-sfx" class="value">80%</span>
    <div id="btn-sfx-up" class="btn">+</div>
  </div>
  <div class="row">
    <span class="label">MUSIC</span>
    <div id="btn-music-down" class="btn">-</div>
    <span id="set-music" class="value">50%</span>
    <div id="btn-music-up" class="btn">+</div>
  </div>
  <div class="row">
    <span class="label">THEME</span>
    <div id="btn-theme-prev" class="btn">PREV</div>
    <span id="set-theme" class="value">Neon Holodeck</span>
    <div id="btn-theme-next" class="btn">NEXT</div>
  </div>
  <div id="btn-set-back" class="back">BACK</div>
</div>
