<!-- ui/challenge.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 2; background-color: rgba(0,0,0,0.85); border-color: #ff33ff; border-width: 0.1; border-radius: 1; align-items: center; gap: 0.6; }
  .title { font-size: 2.5; color: #ff33ff; font-weight: bold; }
  .row { display: flex; flex-direction: row; gap: 0.5; align-items: center; }
  .label { font-size: 1.3; color: #888888; }
  .value { font-size: 1.3; color: #ff33ff; font-weight: bold; }
  .btn { font-size: 1.5; color: #ff33ff; background-color: rgba(255,51,255,0.1); padding-top: 0.2; padding-bottom: 0.2; padding-left: 0.8; padding-right: 0.8; border-color: #ff33ff; border-width: 0.03; border-radius: 0.3; cursor: pointer; }
  .go { font-size: 2; color: #00ff00; background-color: rgba(0,255,0,0.1); padding-top: 0.5; padding-bottom: 0.5; padding-left: 2; padding-right: 2; border-color: #00ff00; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
  .back { font-size: 1.4; color: #888888; background-color: rgba(128,128,128,0.1); padding-top: 0.3; padding-bottom: 0.3; padding-left: 1.5; padding-right: 1.5; border-color: #555555; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
</style>
<div class="panel">
  <span class="title">CUSTOM CHALLENGE</span>
  <div class="row">
    <span class="label">RINGS</span>
    <div id="btn-ch-rings-down" class="btn">-</div>
    <span id="ch-rings" class="value">10</span>
    <div id="btn-ch-rings-up" class="btn">+</div>
  </div>
  <div class="row">
    <span class="label">TIME</span>
    <div id="btn-ch-time-down" class="btn">-</div>
    <span id="ch-time" class="value">OFF</span>
    <div id="btn-ch-time-up" class="btn">+</div>
  </div>
  <div class="row">
    <span class="label">WIND</span>
    <div id="btn-ch-wind-down" class="btn">-</div>
    <span id="ch-wind" class="value">OFF</span>
    <div id="btn-ch-wind-up" class="btn">+</div>
  </div>
  <div class="row">
    <span class="label">MOVE PEGS</span>
    <div id="btn-ch-move" class="btn">OFF</div>
  </div>
  <div class="row">
    <span class="label">POWER-UPS</span>
    <div id="btn-ch-power" class="btn">OFF</div>
  </div>
  <div id="btn-ch-go" class="go">START</div>
  <div id="btn-ch-back" class="back">BACK</div>
</div>
