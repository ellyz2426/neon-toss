<!-- ui/wave.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 0.4; background-color: rgba(0,0,0,0.6); border-color: #ff8800; border-width: 0.05; border-radius: 0.4; align-items: center; gap: 0.1; }
  .label { font-size: 0.8; color: #ff8800; }
  .wave { font-size: 1.6; color: #ff8800; font-weight: bold; }
  .info { font-size: 0.9; color: #888888; }
</style>
<div class="panel">
  <span class="label">MARATHON</span>
  <span id="wave-num" class="wave">WAVE 1</span>
  <span id="wave-info" class="info">10 rings</span>
</div>
