<!-- ui/difficulty.uikitml -->
<style>
  .panel { display: flex; flex-direction: column; padding: 2; background-color: rgba(0,0,0,0.85); border-color: #00ffff; border-width: 0.1; border-radius: 1; align-items: center; gap: 1; }
  .title { font-size: 3; color: #00ffff; font-weight: bold; }
  .btn { font-size: 2; color: #00ffff; background-color: rgba(0,255,255,0.1); padding-top: 0.5; padding-bottom: 0.5; padding-left: 3; padding-right: 3; border-color: #00ffff; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
  .btn-easy { color: #33ff33; border-color: #33ff33; background-color: rgba(51,255,51,0.1); }
  .btn-hard { color: #ff3333; border-color: #ff3333; background-color: rgba(255,51,51,0.1); }
  .back { font-size: 1.4; color: #888888; background-color: rgba(128,128,128,0.1); padding-top: 0.3; padding-bottom: 0.3; padding-left: 1.5; padding-right: 1.5; border-color: #555555; border-width: 0.05; border-radius: 0.5; cursor: pointer; }
</style>
<div class="panel">
  <span class="title">DIFFICULTY</span>
  <div id="btn-easy" class="btn btn-easy">EASY</div>
  <div id="btn-medium" class="btn">MEDIUM</div>
  <div id="btn-hard" class="btn btn-hard">HARD</div>
  <div id="btn-diff-back" class="back">BACK</div>
</div>
